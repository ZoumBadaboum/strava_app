# Récupère ces valeurs sur https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# L'URL publique de ton site (celle que Strava doit pouvoir appeler en retour).
# En local : http://localhost:3000
# Une fois déployé : https://ton-domaine.example
BASE_URL=http://localhost:3000

# Code que TOUTE la famille utilise pour ouvrir le site (choisis-en un simple à retenir/partager)
SITE_ACCESS_CODE=change-moi

# Code que TOI SEUL connais, pour passer en mode admin (accepter/retirer des membres)
ADMIN_CODE=change-moi-aussi

# Clé utilisée pour signer les cookies de session — génère une valeur aléatoire, ex :
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
COOKIE_SECRET=remplace-par-une-valeur-aleatoire

# Adresse de connexion à ta base Postgres Supabase.
# Récupère-la sur ton projet Supabase : Connect -> onglet "Transaction pooler"
# (PAS "Direct connection" — celle-ci est en IPv6 et Render n'y arrive pas).
# Ressemble à : postgres://postgres.xxxxxxxxxxxx:TON-MOT-DE-PASSE@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

PORT=3000
